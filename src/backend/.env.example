PORT=4001

DB_HOST=localhost
DB_PORT=1433
DB_NAME=LeagueCore
DB_USER=sa
DB_PASSWORD=

# OBLIGATORIO en produccion: sin esta variable la API no arranca (NODE_ENV=production).
# En desarrollo se permite un valor local por defecto para no romper el arranque al clonar,
# pero ese valor esta publicado en el repo: nunca debe usarse fuera de desarrollo.
# Generar uno largo y aleatorio, por ejemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

FRONTEND_ORIGIN=http://localhost:5173

# Solo desarrollo. El panel de credenciales de prueba del login (Ctrl+L+9) solo se muestra al usar el
# sistema desde esta misma PC; el acceso por el tunel de Cloudflare recibe 404. Descomentar para permitirlo
# a proposito (p. ej. probar desde el celular). Nunca en produccion: alli siempre responde 404.
# DEV_CREDENTIALS_REMOTE=true
